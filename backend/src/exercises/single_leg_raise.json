{
  "id": "single_leg_raise",
  "name": "Single Leg Raise",
  "type": "rep",
  "per_side": true,
  "description": "Core exercise where you raise one leg at a time while lying on your back. Each leg counts independently.",
  "camera_angle": "side",
  "required_landmarks": {
    "left": [11, 23, 25, 27],
    "right": [12, 24, 26, 28]
  },
  "angles": {
    "hip_flexion": {
      "description": "Hip flexion angle — how high the leg is raised (shoulder-hip-ankle)",
      "left": [11, 23, 27],
      "right": [12, 24, 28],
      "average": false
    },
    "knee_bend": {
      "description": "Knee angle — should stay near 180° (straight leg)",
      "left": [23, 25, 27],
      "right": [24, 26, 28],
      "average": false
    }
  },
  "phases": {
    "bottom": {
      "description": "Leg resting near the floor",
      "condition": { "angle": "hip_flexion", "above": 145 },
      "exit": { "angle": "hip_flexion", "below": 140 }
    },
    "raising": {
      "description": "Lifting leg upward",
      "condition": { "angle": "hip_flexion", "below": 140 },
      "exit": { "angle": "hip_flexion", "below": 115 }
    },
    "top": {
      "description": "Leg raised to ~90° or higher",
      "condition": { "angle": "hip_flexion", "below": 115 },
      "exit": { "angle": "hip_flexion", "above": 120 }
    },
    "lowering": {
      "description": "Controlled descent back down",
      "condition": { "angle": "hip_flexion", "above": 120 },
      "exit": { "angle": "hip_flexion", "above": 145 }
    }
  },
  "phase_order": ["bottom", "raising", "top", "lowering"],
  "rep_cycle": ["bottom", "raising", "top", "lowering", "bottom"],
  "form_checks": [
    {
      "id": "knee_straight",
      "name": "Straight Leg",
      "type": "angle_range",
      "description": "Knee should stay nearly straight",
      "angle": "knee_bend",
      "good_min": 155,
      "good_max": 185,
      "warn_below": 140,
      "warn_above": 190,
      "severity": "warning",
      "event_type": "knee_bending",
      "message": "Keep your leg straight — don't bend at the knee"
    },
    {
      "id": "raise_height",
      "name": "Full Raise",
      "type": "angle_threshold",
      "description": "Leg should reach approximately 90° to the body",
      "angle": "hip_flexion",
      "phase": "top",
      "good_below": 115,
      "warn_above": 130,
      "severity": "info",
      "event_type": "depth_too_shallow",
      "message": "Raise your leg higher — aim for 90° to your body"
    }
  ],
  "scoring": {
    "components": [
      { "name": "range_of_motion", "weight": 0.4, "angle": "hip_flexion", "ideal_at_top": 90, "penalty_per_degree": 2 },
      { "name": "leg_straightness", "weight": 0.35, "form_check": "knee_straight", "ideal_angle": 175, "penalty_per_degree": 3 },
      { "name": "control", "weight": 0.25, "type": "tempo" }
    ]
  },
  "smoothing": {
    "ema_alpha": 0.25,
    "buffer_size": 15,
    "min_dwell_ms": 200,
    "velocity_threshold": 4
  }
}
