{
  "id": "squat",
  "name": "Squat",
  "type": "rep",
  "description": "A fundamental lower body exercise targeting quads, glutes, and core stability.",
  "camera_angle": "front",
  "required_landmarks": {
    "left": [23, 25, 27],
    "right": [24, 26, 28],
    "upper": [11, 12]
  },
  "angles": {
    "knee": {
      "description": "Knee flexion angle — primary phase driver",
      "left": [23, 25, 27],
      "right": [24, 26, 28],
      "average": true
    },
    "hip": {
      "description": "Hip flexion — torso lean indicator",
      "left": [11, 23, 25],
      "right": [12, 24, 26],
      "average": true
    },
    "body_line": {
      "description": "Shoulder-hip-ankle alignment",
      "left": [11, 23, 27],
      "right": [12, 24, 28],
      "average": true
    }
  },
  "phases": {
    "top": {
      "description": "Standing upright",
      "condition": { "angle": "knee", "above": 165 },
      "exit": { "angle": "knee", "below": 160 }
    },
    "descending": {
      "description": "Lowering into squat",
      "condition": { "angle": "knee", "below": 160, "direction": "decreasing" },
      "exit": { "angle": "knee", "below": 95 }
    },
    "bottom": {
      "description": "Full depth — thighs parallel or below",
      "condition": { "angle": "knee", "below": 95 },
      "exit": { "angle": "knee", "above": 100 }
    },
    "ascending": {
      "description": "Rising back to standing",
      "condition": { "angle": "knee", "above": 100, "direction": "increasing" },
      "exit": { "angle": "knee", "above": 165 }
    }
  },
  "phase_order": ["top", "descending", "bottom", "ascending"],
  "rep_cycle": ["top", "descending", "bottom", "ascending", "top"],
  "form_checks": [
    {
      "id": "knee_cave",
      "name": "Knee Cave",
      "type": "distance_ratio",
      "description": "Knees should track over toes, not collapse inward",
      "numerator_landmarks": [25, 26],
      "denominator_landmarks": [27, 28],
      "axis": "x",
      "good_min": 0.8,
      "warn_below": 0.7,
      "severity": "warning",
      "event_type": "knees_caving",
      "message": "Keep your knees aligned over your toes"
    },
    {
      "id": "depth",
      "name": "Squat Depth",
      "type": "angle_threshold",
      "description": "Must reach parallel or below at bottom",
      "angle": "knee",
      "phase": "bottom",
      "good_below": 95,
      "warn_above": 120,
      "severity": "info",
      "event_type": "depth_too_shallow",
      "message": "Go deeper — aim for thighs parallel to the floor"
    },
    {
      "id": "torso_lean",
      "name": "Torso Lean",
      "type": "angle_range",
      "description": "Torso should stay relatively upright",
      "angle": "hip",
      "good_min": 70,
      "good_max": 110,
      "warn_below": 60,
      "warn_above": 120,
      "severity": "warning",
      "event_type": "torso_leaning",
      "message": "Keep your chest up — too much forward lean"
    }
  ],
  "scoring": {
    "components": [
      { "name": "depth", "weight": 0.4, "angle": "knee", "ideal_at_bottom": 90, "penalty_per_degree": 2 },
      { "name": "alignment", "weight": 0.3, "form_check": "knee_cave", "penalty_multiplier": 30 },
      { "name": "torso", "weight": 0.3, "angle": "hip", "ideal": 90, "penalty_per_degree": 2 }
    ]
  },
  "smoothing": {
    "ema_alpha": 0.3,
    "buffer_size": 15,
    "min_dwell_ms": 150,
    "velocity_threshold": 5
  }
}
